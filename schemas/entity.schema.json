{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daemon-tools.local/schemas/entity.schema.json",
  "title": "Daemon Tools Entity",
  "type": "object",
  "required": ["id", "name", "category", "source", "entries"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "core_rule", "attribute_skill", "combat", "character_option",
        "character_class", "kit_class", "race_lineage", "power_magic",
        "ritual_spell", "item_equipment", "creature_npc", "setting_lore",
        "adventure", "table_generator", "source"
      ]
    },
    "source": {
      "type": "string"
    },
    "sourceTitle": {
      "type": "string"
    },
    "subtype": {
      "type": "string",
      "enum": ["aprimoramento", "class", "kit", "lineage", "linhagem", "magia", "poder", "race", "raca", "ritual"]
    },
    "page": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extractionMethod": {
      "type": "string"
    },
    "certificationStatus": {
      "type": "string"
    },
    "certifiedAs": {
      "type": "string"
    },
    "certifiedArea": {
      "type": "string"
    },
    "lockedArea": {
      "type": "string"
    },
    "certificationId": {
      "type": "string"
    },
    "certificationMethod": {
      "type": "string"
    },
    "costText": {
      "type": "string",
      "description": "Texto do custo em pontos (ex: '2 pontos')"
    },
    "aprimoramentoCost": {
      "type": ["integer", "null"],
      "description": "Custo numérico do aprimoramento"
    },
    "periciaCost": {
      "type": ["integer", "null"]
    },
    "skillsText": {
      "type": "string"
    },
    "aprimoramentosText": {
      "type": "string"
    },
    "powerMagicContext": {
      "type": "string",
      "description": "Contexto do caminho/círculo ao qual o poder pertence"
    },
    "kitContext": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "description": "Área de navegação à qual esta entidade pertence"
    },
    "subgroupLabel": {
      "type": "string"
    },
    "sourceKindLabel": {
      "type": "string"
    },
    "entityRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    }
  },
  "additionalProperties": true
}
