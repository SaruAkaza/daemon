{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segment.schema.json",
  "title": "DOCX semantic segment",
  "type": "object",
  "required": [
    "id",
    "source",
    "sourceFile",
    "sourcePath",
    "title",
    "paragraphRange",
    "primaryArea",
    "classifications",
    "reviewStatus",
    "reviewFlags",
    "text"
  ],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string" },
    "sourceFile": { "type": "string" },
    "sourcePath": { "type": "string" },
    "sourceQualityStatus": { "type": "string" },
    "title": { "type": "string" },
    "heading": { "type": "string" },
    "paragraphRange": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "blockKinds": {
      "type": "array",
      "items": { "type": "string", "enum": ["paragraph", "table"] }
    },
    "charCount": { "type": "integer", "minimum": 0 },
    "wordCount": { "type": "integer", "minimum": 0 },
    "primaryArea": { "type": "string" },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "label", "score", "confidence", "evidence"],
        "properties": {
          "area": { "type": "string" },
          "label": { "type": "string" },
          "score": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["draft_review", "reviewed", "approved", "rejected"]
    },
    "reviewFlags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "text": { "type": "string" }
  }
}
