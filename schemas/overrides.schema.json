{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daemon-tools.local/schemas/overrides.schema.json",
  "title": "Daemon Tools Editorial Overrides",
  "type": "object",
  "required": ["version", "records"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "id"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["replace", "hide", "publish", "tag_review", "quarantine"]
          },
          "id": {
            "type": "string",
            "description": "ID da entidade ou sourcePart alvo"
          },
          "area": {
            "type": "string",
            "description": "Área para escopo do override (opcional)"
          },
          "itemType": {
            "type": "string",
            "enum": ["entity", "sourcePart"],
            "description": "Tipo do item para escopo (opcional)"
          },
          "reason": {
            "type": "string",
            "description": "Justificativa editorial para auditoria (não processada pelo script)"
          },
          "note": {
            "type": "string",
            "description": "Nota editorial; propagada como campo 'manualOverrideNote' no item"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "entries": {
            "type": "array"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "subtype": {
            "type": "string"
          },
          "contentKind": {
            "type": "string"
          },
          "contentKindLabel": {
            "type": "string"
          },
          "sourceFamily": {
            "type": "string"
          },
          "sourceFamilyLabel": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "entityRefs": {
            "type": "array"
          },
          "costText": {
            "type": "string"
          },
          "requirements": {
            "type": "string"
          },
          "skillsText": {
            "type": "string"
          },
          "aprimoramentosText": {
            "type": "string"
          },
          "attributesText": {
            "type": "string"
          },
          "advantagesText": {
            "type": "string"
          },
          "disadvantagesText": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
